<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <!-- TvBaseService's volume receiver: HisenseVolume checks it is there, and the profile whether it is turned off. -->
        <package android:name="com.hisense.tv.baseservice" />
        <!-- HsPcmShare, the remote's mic: the profile checks whether it is there and turned on. -->
        <package android:name="com.hisense.pcm.share" />
        <package android:name="com.vt.mic.service" />
        <!-- HisenseInputs. -->
        <package android:name="com.jamdeo.tv.service" />
        <package android:name="com.jamdeo.tv.livetv" />
    </queries>
</manifest>
