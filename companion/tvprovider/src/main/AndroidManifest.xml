<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher">

    <!--
        The permissions com.android.providers.tv defines. Apps (VK, Kinopoisk, Rutube, SmartTube)
        request them; "normal" here so they are granted without a prompt.
    -->
    <permission
        android:name="com.android.providers.tv.permission.READ_EPG_DATA"
        android:protectionLevel="normal" />
    <permission
        android:name="com.android.providers.tv.permission.WRITE_EPG_DATA"
        android:protectionLevel="normal" />
    <permission
        android:name="com.android.providers.tv.permission.ACCESS_ALL_EPG_DATA"
        android:protectionLevel="signature" />
    <permission
        android:name="com.android.providers.tv.permission.ACCESS_WATCHED_PROGRAMS"
        android:protectionLevel="signature" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- The process name comes from the build: processNames in build-logic. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:process="${providerProcess}">

        <provider
            android:name=".CompanionTvProvider"
            android:authorities="android.media.tv"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <activity
            android:name=".RequestBrowsableActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.media.tv.action.REQUEST_CHANNEL_BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
