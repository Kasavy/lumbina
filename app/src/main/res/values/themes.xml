<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The first frame of a cold start, before Compose draws: the top of the default wallpaper
         gradient (HomeBackgrounds.kt), so the screen fades in rather than flashing black. -->
    <color name="window_background">#FF151A22</color>

    <style name="Theme.Lumbina" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
